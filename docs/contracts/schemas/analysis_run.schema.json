{
  "$defs": {
    "EvidenceRef": {
      "description": "Which exact file a run used: the id plus its content hash.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "id",
        "filename"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "StageResult": {
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "real",
            "fixture",
            "skipped",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        }
      },
      "required": [
        "stage",
        "status"
      ],
      "title": "StageResult",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "evidence_count": {
      "title": "Evidence Count",
      "type": "integer"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageResult"
      },
      "title": "Stages",
      "type": "array"
    },
    "evidence": {
      "description": "Manifest of the evidence analysed",
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "evidence_count",
    "stages"
  ],
  "title": "AnalysisRun",
  "type": "object"
}
