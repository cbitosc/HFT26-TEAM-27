{
  "$defs": {
    "SourceType": {
      "enum": [
        "video",
        "witness",
        "sensor"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "description": "One uploaded file. Created by the upload endpoint, read by modules 1\u20132.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Case-wide display id in upload order, e.g. EVID-002 (never reused)",
      "title": "Ref"
    },
    "kind": {
      "$ref": "#/$defs/SourceType"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "content_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Type"
    },
    "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
    },
    "stored_path": {
      "title": "Stored Path",
      "type": "string"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Content hash taken at upload (chain of custody)",
      "title": "Sha256"
    },
    "details": {
      "additionalProperties": true,
      "description": "Upload-time inspection, e.g. video fps or CSV layout",
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "id",
    "kind",
    "filename",
    "size_bytes",
    "stored_path",
    "uploaded_at"
  ],
  "title": "Evidence",
  "type": "object"
}
