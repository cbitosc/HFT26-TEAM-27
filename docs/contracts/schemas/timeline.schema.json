{
  "$defs": {
    "SourceType": {
      "enum": [
        "video",
        "witness",
        "sensor"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TimelineEvent": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "t_start_s": {
          "title": "T Start S",
          "type": "number"
        },
        "t_end_s": {
          "title": "T End S",
          "type": "number"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "category": {
          "enum": [
            "vehicle_motion",
            "signal",
            "collision",
            "post_collision",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "vehicle_ids": {
          "items": {
            "type": "string"
          },
          "title": "Vehicle Ids",
          "type": "array"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "source_types": {
          "items": {
            "$ref": "#/$defs/SourceType"
          },
          "title": "Source Types",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "uncertainty_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Uncertainty S",
          "type": "number"
        },
        "basis": {
          "anyOf": [
            {
              "enum": [
                "measured",
                "reported",
                "derived",
                "inferred"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Strongest basis among the supporting observations (measured > derived > reported > inferred)",
          "title": "Basis"
        },
        "basis_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Basis Counts",
          "type": "object"
        }
      },
      "required": [
        "id",
        "t_start_s",
        "t_end_s",
        "label",
        "category",
        "observation_ids",
        "source_types",
        "confidence"
      ],
      "title": "TimelineEvent",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.3.1",
      "title": "Schema Version",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "reference_time": {
      "format": "date-time",
      "title": "Reference Time",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "incident_id",
    "reference_time",
    "generated_at",
    "events"
  ],
  "title": "Timeline",
  "type": "object"
}
